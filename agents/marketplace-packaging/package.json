{
  "name": "@llm-marketplace/marketplace-packaging-agent",
  "version": "1.0.0",
  "description": "Marketplace Packaging Agent - Package agents, templates, and workflows for distribution",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/cli/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/**/*.ts",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "deploy": "gcloud functions deploy marketplace-packaging-agent --runtime nodejs20 --trigger-http --entry-point marketplacePackagingAgent"
  },
  "bin": {
    "packaging-agent": "./dist/cli/index.js"
  },
  "dependencies": {
    "@llm-marketplace/agentics-contracts": "workspace:*",
    "commander": "^11.1.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.2",
    "vitest": "^1.0.4",
    "@vitest/coverage-v8": "^1.0.4",
    "eslint": "^8.55.0"
  },
  "keywords": [
    "llm-marketplace",
    "packaging",
    "agent",
    "google-cloud-functions"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/roshanrameshhub/inferops.git"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist",
    "src"
  ]
}
